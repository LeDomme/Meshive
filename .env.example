# Runtime identity. Match the numeric IDs that may read the model volume.
PUID=10001
PGID=10001

# The standalone HTTP example uses development mode so browser cookies work
# without TLS. The Traefik example always uses production mode.
MESHIVE_ENVIRONMENT=development

# Meshive runtime paths inside the container.
MESHIVE_DATA_DIR=/app/data
MESHIVE_CACHE_DIR=/app/cache
MESHIVE_BACKUP_DIR=/backups
MESHIVE_FRONTEND_DIST=/app/frontend
MESHIVE_ALLOWED_LIBRARY_ROOT=/models

# Authentication and first-run setup.
MESHIVE_SESSION_COOKIE_NAME=meshive_session
MESHIVE_SESSION_LIFETIME_DAYS=7
MESHIVE_AUTH_RATE_LIMIT_ATTEMPTS=5
MESHIVE_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Required only until the first administrator has been created.
MESHIVE_SETUP_TOKEN=replace-with-a-long-random-value

# Optional password recovery email delivery.
MESHIVE_PUBLIC_URL=https://meshive.example.invalid
MESHIVE_SMTP_HOST=
MESHIVE_SMTP_PORT=587
MESHIVE_SMTP_USERNAME=
MESHIVE_SMTP_PASSWORD=
MESHIVE_SMTP_FROM=
# ssl for implicit TLS (commonly port 465), starttls (commonly port 587), or none.
MESHIVE_SMTP_SECURITY=starttls
MESHIVE_SMTP_TIMEOUT_SECONDS=15
MESHIVE_PASSWORD_RESET_LIFETIME_MINUTES=30
MESHIVE_EMAIL_VERIFICATION_LIFETIME_HOURS=24

# Archive inspection limits. Values ending in _BYTES are raw byte counts.
MESHIVE_ARCHIVE_COMMAND=7z
MESHIVE_ARCHIVE_TIMEOUT_SECONDS=120
MESHIVE_ARCHIVE_MAX_ENTRIES=100000
MESHIVE_ARCHIVE_MAX_OUTPUT_BYTES=67108864
MESHIVE_ARCHIVE_IMAGE_MAX_CANDIDATES=12
MESHIVE_ARCHIVE_IMAGE_MAX_ENTRY_BYTES=33554432
MESHIVE_ARCHIVE_IMAGE_MAX_COMPRESSED_BYTES=33554432
MESHIVE_ARCHIVE_IMAGE_MAX_TOTAL_BYTES=134217728
MESHIVE_ARCHIVE_IMAGE_MAX_PIXELS=40000000
MESHIVE_ARCHIVE_IMAGE_TIMEOUT_SECONDS=30

# Backup restore limits.
MESHIVE_BACKUP_MAX_RESTORE_BYTES=5368709120
MESHIVE_BACKUP_RESTORE_MIN_FREE_BYTES=67108864

# Runtime concurrency and thumbnail generation.
MESHIVE_MAX_CONCURRENT_SCANS=1
MESHIVE_MAX_CONCURRENT_DOWNLOADS=4
MESHIVE_THUMBNAIL_SIZE=480
MESHIVE_THUMBNAIL_QUALITY=82
MESHIVE_THUMBNAIL_MAX_BYTES=102400
MESHIVE_ARCHIVE_IMAGE_DETAIL_SIZE=1600
MESHIVE_ARCHIVE_IMAGE_DETAIL_MAX_BYTES=786432

# Standalone Compose deployment.
MESHIVE_PORT=8000

# Container image used by both Compose examples.
MESHIVE_IMAGE=ghcr.io/ledomme/meshive:1.2.0

# External volumes used by both Compose examples.
MESHIVE_MODELS_VOLUME=meshive-models
MESHIVE_BACKUP_VOLUME=meshive-backups

# Required only by compose.traefik.yaml.
MESHIVE_HOST=meshive.example.invalid
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINTS=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
