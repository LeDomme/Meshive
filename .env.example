# Typical deployment configuration. Copy this file to .env and adapt it.
MESHIVE_IMAGE=ghcr.io/ledomme/meshive:1.6.2
PUID=10001
PGID=10001

# Required only until the first administrator has been created. Remove this
# line after setup and recreate the container.
MESHIVE_SETUP_TOKEN=replace-with-a-long-random-value

# Standalone Compose deployment (trusted network or evaluation only).
MESHIVE_ENVIRONMENT=development
MESHIVE_PORT=8000

# Existing external Docker volumes.
MESHIVE_MODELS_VOLUME=meshive-models
MESHIVE_BACKUP_VOLUME=meshive-backups

# Required only by compose.traefik.yaml.
MESHIVE_HOST=meshive.example.invalid
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINTS=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Advanced runtime options are not automatically passed into a container from
# this file. Add required overrides under the service's environment: section;
# see docs/configuration.md for the complete reference and examples.
